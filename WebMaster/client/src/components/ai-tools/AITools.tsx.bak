import { useState, useEffect, useRef } from "react";
import { AnimatePresence, motion } from "framer-motion";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Progress } from "@/components/ui/progress";
import { Badge } from "@/components/ui/badge";
import { apiRequest } from "@/lib/queryClient";
import { useToast } from "@/hooks/use-toast";
import { ApiKeyModal, type ApiServiceType } from "@/components/ui/api-key-modal";
import { 
  Loader2, 
  Copy, 
  Award, 
  Star, 
  Code, 
  CheckCircle2, 
  MessageSquarePlus, 
  Sparkles,
  Rocket,
  Terminal,
  Wand2,
  Film,
  Download,
  ExternalLink,
  AlertCircle,
  RefreshCw
} from "lucide-react";

// Points and achievements system
const PointsSystem = ({ points, level, onAchievement }: { 
  points: number; 
  level: number;
  onAchievement: (achievement: string) => void;
}) => {
  const progressPercent = (points % 100) / 100 * 100;
  
  return (
    <div className="fixed bottom-0 right-0 bg-white p-4 shadow-lg rounded-tl-lg z-10 w-56">
      <div className="flex justify-between items-center mb-2">
        <span className="font-bold">Level {level}</span>
        <Badge variant="outline" className="bg-primary text-white">
          {points} points
        </Badge>
      </div>
      <Progress value={progressPercent} className="h-2 mb-2" />
      <div className="text-xs text-gray-500 text-right">
        {100 - (points % 100)} points to next level
      </div>
    </div>
  );
};

const AITools = () => {
  const { toast } = useToast();
  const iframeRef = useRef<HTMLIFrameElement>(null);
  
  // State for video generation
  const [videoPrompt, setVideoPrompt] = useState("");
  const [videoStyle, setVideoStyle] = useState("3D Animation");
  const [videoDuration, setVideoDuration] = useState("15 seconds");
  const [isGeneratingVideo, setIsGeneratingVideo] = useState(false);
  const [videoProgress, setVideoProgress] = useState(0);
  const [videoResult, setVideoResult] = useState<{
    videoId?: string;
    status?: string;
    videoUrl?: string;
    isFallback?: boolean;
  } | null>(null);
  
  // State for text transformation
  const [textContent, setTextContent] = useState("");
  const [transformStyle, setTransformStyle] = useState("Creative");
  const [isTransformingText, setIsTransformingText] = useState(false);
  const [textProgress, setTextProgress] = useState(0);
  
  // State for website generation
  const [websiteDescription, setWebsiteDescription] = useState("");
  const [websiteTheme, setWebsiteTheme] = useState("Modern");
  const [websitePages, setWebsitePages] = useState("Landing Page");
  const [brandingName, setBrandingName] = useState("");
  const [isGeneratingWebsite, setIsGeneratingWebsite] = useState(false);
  const [websiteProgress, setWebsiteProgress] = useState(0);
  const [previewMode, setPreviewMode] = useState(false);
  
  // State for Replit app generation
  const [replitAppDescription, setReplitAppDescription] = useState("");
  const [replitAppLanguage, setReplitAppLanguage] = useState("JavaScript");
  const [replitAppFrameworks, setReplitAppFrameworks] = useState("React");
  const [isGeneratingReplitApp, setIsGeneratingReplitApp] = useState(false);
  const [replitProgress, setReplitProgress] = useState(0);
  
  // State for image generation
  const [imagePrompt, setImagePrompt] = useState("");
  const [imageStyle, setImageStyle] = useState("Photorealistic");
  const [negativePrompt, setNegativePrompt] = useState("");
  const [imageSeed, setImageSeed] = useState<number | undefined>(undefined);
  const [imageWidth, setImageWidth] = useState(1024);
  const [imageHeight, setImageHeight] = useState(1024);
  const [numImages, setNumImages] = useState(1);
  const [isGeneratingImage, setIsGeneratingImage] = useState(false);
  const [imageProgress, setImageProgress] = useState(0);
  const [imageResult, setImageResult] = useState<{
    images: string[];
    isFallback: boolean;
    error?: string;
  } | null>(null);
  
  // General state
  const [generatedContent, setGeneratedContent] = useState<any>(null);
  const [isGenerating, setIsGenerating] = useState(false);
  const [activeTab, setActiveTab] = useState("text");
  
  // API Key Modal state
  const [apiKeyModalOpen, setApiKeyModalOpen] = useState(false);
  const [apiKeyService, setApiKeyService] = useState<ApiServiceType>('together');
  const [apiKeyError, setApiKeyError] = useState<string>('');
  
  // Gamification state
  const [points, setPoints] = useState(0);
  const [level, setLevel] = useState(1);
  const [achievements, setAchievements] = useState<string[]>([]);
  const [showAchievement, setShowAchievement] = useState<string | null>(null);
  
  // Process feedback and progress simulation
  useEffect(() => {
    if (isTransformingText) {
      const interval = setInterval(() => {
        setTextProgress(prev => {
          if (prev >= 100) {
            clearInterval(interval);
            return 100;
          }
          return prev + 10;
        });
      }, 200);
      return () => clearInterval(interval);
    } else {
      setTextProgress(0);
    }
  }, [isTransformingText]);
  
  useEffect(() => {
    if (isGeneratingWebsite) {
      const interval = setInterval(() => {
        setWebsiteProgress(prev => {
          if (prev >= 100) {
            clearInterval(interval);
            return 100;
          }
          return prev + 5;
        });
      }, 300);
      return () => clearInterval(interval);
    } else {
      setWebsiteProgress(0);
    }
  }, [isGeneratingWebsite]);
  
  useEffect(() => {
    if (isGeneratingReplitApp) {
      const interval = setInterval(() => {
        setReplitProgress(prev => {
          if (prev >= 100) {
            clearInterval(interval);
            return 100;
          }
          return prev + 7;
        });
      }, 250);
      return () => clearInterval(interval);
    } else {
      setReplitProgress(0);
    }
  }, [isGeneratingReplitApp]);
  
  // Video generation progress
  useEffect(() => {
    if (isGeneratingVideo) {
      const interval = setInterval(() => {
        setVideoProgress(prev => {
          if (prev >= 100) {
            clearInterval(interval);
            return 100;
          }
          return prev + 3; // Slower progress for video generation
        });
      }, 400);
      return () => clearInterval(interval);
    } else {
      setVideoProgress(0);
    }
  }, [isGeneratingVideo]);
  
  // Image generation progress
  useEffect(() => {
    if (isGeneratingImage) {
      const interval = setInterval(() => {
        setImageProgress(prev => {
          if (prev >= 100) {
            clearInterval(interval);
            return 100;
          }
          return prev + 5; // Medium-speed progress for image generation
        });
      }, 350);
      return () => clearInterval(interval);
    } else {
      setImageProgress(0);
    }
  }, [isGeneratingImage]);
  
  // Polling for video status updates
  useEffect(() => {
    if (videoResult?.videoId && videoResult.status !== "completed" && !isGeneratingVideo) {
      const interval = setInterval(async () => {
        try {
          const response = await apiRequest(
            "GET", 
            `/api/video/${videoResult.videoId}/status`
          );
          
          if (response.ok) {
            const responseData = await response.json();
            const data = responseData.data || responseData;
            
            // Update video result and progress
            setVideoResult(prevState => {
              if (!prevState) return prevState;
              return {
                ...prevState,
                status: data.status || prevState.status,
                videoUrl: data.videoUrl || prevState.videoUrl
              };
            });
            
            // Update the generated content result too
            setGeneratedContent((prevState: any) => {
              if (prevState?.type === 'video') {
                return {
                  ...prevState,
                  result: {
                    ...prevState.result,
                    status: data.status || prevState.result.status,
                    videoUrl: data.videoUrl || prevState.result.videoUrl
                  }
                };
              }
              return prevState;
            });
            
            // Update progress based on status
            if (data.status === "processing") {
              setVideoProgress(65); // Mid-way through
            } else if (data.status === "rendering") {
              setVideoProgress(85); // Almost done
            } else if (data.status === "completed") {
              setVideoProgress(100);
              
              // Show completion toast
              toast({
                title: "Video Ready!",
                description: "Your video has been generated and is ready to view.",
              });
              
              // Clean up interval
              clearInterval(interval);
            }
          }
        } catch (error) {
          console.error("Error checking video status:", error);
        }
      }, 5000); // Check every 5 seconds
      
      return () => clearInterval(interval);
    }
  }, [videoResult?.videoId, videoResult?.status, isGeneratingVideo, toast]);
  
  // Achievement handling
  const addAchievement = (achievement: string) => {
    if (!achievements.includes(achievement)) {
      setAchievements([...achievements, achievement]);
      setShowAchievement(achievement);
      
      // Hide achievement notification after 3 seconds
      setTimeout(() => {
        setShowAchievement(null);
      }, 3000);
      
      // Add points for achievement
      addPoints(50);
    }
  };
  
  const addPoints = (amount: number) => {
    setPoints(prev => {
      const newPoints = prev + amount;
      // Level up if points reach multiple of 100
      if (Math.floor(newPoints / 100) > Math.floor(prev / 100)) {
        toast({
          title: "Level Up!",
          description: `You've reached level ${Math.floor(newPoints / 100) + 1}!`,
          variant: "default",
        });
        setLevel(Math.floor(newPoints / 100) + 1);
      }
      return newPoints;
    });
  };
  
  // Video generation handler
  const handleVideoGeneration = async () => {
    if (!videoPrompt) {
      toast({
        title: "Prompt Required",
        description: "Please enter a description of the video you want to generate.",
        variant: "destructive",
      });
      return;
    }
    
    try {
      setIsGeneratingVideo(true);
      
      // Simulate processing steps with progress updates
      const processingSteps = [
        "Analyzing video description...",
        "Creating storyboard...",
        "Generating video assets...",
        "Composing scenes...",
        "Rendering final video..."
      ];
      
      for (let i = 0; i < processingSteps.length; i++) {
        toast({
          title: "Creating Video",
          description: processingSteps[i],
        });
        // Simulate processing time
        await new Promise(resolve => setTimeout(resolve, 1500));
      }
      
      // Parse the duration to get the number of seconds
      let durationSeconds = 15;
      if (videoDuration === "30 seconds") durationSeconds = 30;
      if (videoDuration === "60 seconds") durationSeconds = 60;
      if (videoDuration === "2 minutes") durationSeconds = 120;
      
      // Start video generation with Predis API
      const response = await apiRequest(
        "POST",
        "/api/video/generate",
        {
          prompt: videoPrompt,
          musicType: videoStyle,
          duration: durationSeconds
        }
      );
      
      if (response.ok) {
        const responseData = await response.json();
        const data = responseData.data || responseData; // Handle either format
        
        setVideoResult({
          videoId: data.videoId,
          status: data.status || 'processing',
          videoUrl: data.videoUrl,
          isFallback: false
        });
        
        setGeneratedContent({ 
          type: "video", 
          prompt: videoPrompt,
          result: data,
          style: videoStyle,
          duration: videoDuration,
          isFallback: false
        });
        
        // Add points and possibly achievement
        addPoints(50);
        
        if (!achievements.includes("Video Creator")) {
          addAchievement("Video Creator");
        }
        
        toast({
          title: "Video Request Submitted",
          description: "Your video generation request has been submitted. Status updates will appear as it's being processed.",
          variant: "default"
        });
      } else {
        throw new Error("Failed to generate video");
      }
    } catch (error: any) {
      console.error("Error generating video:", error);
      
      // Check if it's an API key error
      if (error.message?.includes('API key') || 
          error.message?.toLowerCase().includes('authenticate') ||
          error.message?.toLowerCase().includes('unauthorized')) {
        
        setApiKeyError("Failed to generate video: API key missing or invalid for Predis AI.");
        setApiKeyService('predis');
        setApiKeyModalOpen(true);
        
        toast({
          title: "API Key Required",
          description: "Please provide your Predis AI API key to generate videos.",
          variant: "destructive",
        });
      } else {
        toast({
          title: "Generation Failed",
          description: "Failed to generate video. Please try again.",
          variant: "destructive",
        });
      }
    } finally {
      setIsGeneratingVideo(false);
    }
  };
  
  // Text transformation handler
  const handleTextTransform = async () => {
    if (!textContent) {
      toast({
        title: "Text Required",
        description: "Please enter some text to transform.",
        variant: "destructive",
      });
      return;
    }
    
    try {
      setIsTransformingText(true);
      
      // Simulate processing steps with progress updates
      const processingSteps = [
        "Analyzing text...",
        "Applying style transformations...",
        "Enhancing language...",
        "Finalizing content..."
      ];
      
      for (let i = 0; i < processingSteps.length; i++) {
        toast({
          title: "Processing",
          description: processingSteps[i],
        });
        // Simulate processing time
        await new Promise(resolve => setTimeout(resolve, 800));
      }
      
      const response = await apiRequest(
        "POST",
        "/api/ai/generate-text",
        {
          prompt: textContent,
          style: transformStyle
        }
      );
      
      if (response.ok) {
        const data = await response.json();
        setGeneratedContent({ 
          type: "text", 
          original: textContent,
          transformed: data.result,
          style: transformStyle,
          isFallback: data.fallback
        });
        
        // Add points and possibly achievement
        addPoints(20);
        
        if (!achievements.includes("Text Transformer")) {
          addAchievement("Text Transformer");
        }
        
        if (data.fallback) {
          toast({
            title: "API Rate Limit",
            description: "Using fallback response due to API rate limiting. Try again later for real-time generation.",
            variant: "default"
          });
        } else {
          toast({
            title: "Text Transformed!",
            description: "Your text has been transformed successfully.",
          });
        }
      } else {
        throw new Error("Failed to transform text");
      }
    } catch (error) {
      console.error("Error transforming text:", error);
      toast({
        title: "Transformation Failed",
        description: "Failed to transform text. Please try again.",
        variant: "destructive",
      });
    } finally {
      setIsTransformingText(false);
    }
  };
  
  // Website generation handler
  const handleWebsiteGeneration = async () => {
    if (!websiteDescription) {
      toast({
        title: "Description Required",
        description: "Please enter a description of the website you want to generate.",
        variant: "destructive",
      });
      return;
    }
    
    try {
      setIsGeneratingWebsite(true);
      
      // Simulate processing steps with progress updates
      const processingSteps = [
        "Analyzing requirements...",
        "Designing layout...",
        "Building HTML structure...",
        "Applying CSS styles...",
        "Generating sitemap..."
      ];
      
      for (let i = 0; i < processingSteps.length; i++) {
        toast({
          title: "Building Website",
          description: processingSteps[i],
        });
        // Simulate processing time
        await new Promise(resolve => setTimeout(resolve, 1000));
      }
      
      const response = await apiRequest(
        "POST",
        "/api/ai/generate-website",
        {
          description: websiteDescription,
          theme: websiteTheme,
          pages: websitePages,
          branding: brandingName
        }
      );
      
      if (response.ok) {
        const data = await response.json();
        setGeneratedContent({ 
          type: "website", 
          description: websiteDescription,
          result: data.result,
          isFallback: data.fallback
        });
        
        // Add points and possibly achievement
        addPoints(30);
        
        if (!achievements.includes("Website Builder")) {
          addAchievement("Website Builder");
        }

        if (data.fallback) {
          toast({
            title: "API Rate Limit",
            description: "Using fallback response due to API rate limiting. Try again later for real-time generation.",
            variant: "default"
          });
        } else {
          toast({
            title: "Website Generated!",
            description: "Your website has been generated successfully.",
          });
        }
      } else {
        throw new Error("Failed to generate website");
      }
    } catch (error) {
      console.error("Error generating website:", error);
      toast({
        title: "Generation Failed",
        description: "Failed to generate website. Please try again.",
        variant: "destructive",
      });
    } finally {
      setIsGeneratingWebsite(false);
    }
  };
  
  // Replit app generation handler
  const handleReplitAppGeneration = async () => {
    if (!replitAppDescription) {
      toast({
        title: "Description Required",
        description: "Please enter a description of the Replit app you want to create.",
        variant: "destructive",
      });
      return;
    }
    
    try {
      setIsGeneratingReplitApp(true);
      
      // Simulate processing steps with progress updates
      const processingSteps = [
        "Analyzing app requirements...",
        "Scaffolding project structure...",
        "Writing main application file...",
        "Adding supporting modules...",
        "Finalizing configuration..."
      ];
      
      for (let i = 0; i < processingSteps.length; i++) {
        toast({
          title: "Building Replit App",
          description: processingSteps[i],
        });
        // Simulate processing time
        await new Promise(resolve => setTimeout(resolve, 900));
      }
      
      const response = await apiRequest(
        "POST",
        "/api/ai/generate-replit-app",
        {
          description: replitAppDescription,
          language: replitAppLanguage,
          frameworks: replitAppFrameworks
        }
      );
      
      if (response.ok) {
        const data = await response.json();
        setGeneratedContent({ 
          type: "replitApp", 
          description: replitAppDescription,
          result: data.result,
          isFallback: data.fallback
        });
        
        // Add points and possibly achievement
        addPoints(40);
        
        if (!achievements.includes("Replit App Creator")) {
          addAchievement("Replit App Creator");
        }
        
        if (data.fallback) {
          toast({
            title: "API Rate Limit",
            description: "Using fallback response due to API rate limiting. Try again later for real-time generation.",
            variant: "default"
          });
        } else {
          toast({
            title: "Replit App Created!",
            description: "Your Replit app has been created successfully.",
          });
        }
      } else {
        throw new Error("Failed to generate Replit app");
      }
    } catch (error) {
      console.error("Error generating Replit app:", error);
      toast({
        title: "Generation Failed",
        description: "Failed to generate Replit app. Please try again.",
        variant: "destructive",
      });
    } finally {
      setIsGeneratingReplitApp(false);
    }
  };
  
  // Image generation handler
  const handleImageGeneration = async () => {
    if (!imagePrompt) {
      toast({
        title: "Prompt Required",
        description: "Please enter a description of the image you want to generate.",
        variant: "destructive",
      });
      return;
    }
    
    try {
      setIsGeneratingImage(true);
      
      // Simulate processing steps with progress updates
      const processingSteps = [
        "Analyzing image prompt...",
        "Creating visual concepts...",
        "Refining details...",
        "Applying artistic style...",
        "Finalizing image..."
      ];
      
      for (let i = 0; i < processingSteps.length; i++) {
        toast({
          title: "Creating Image",
          description: processingSteps[i],
        });
        // Simulate processing time
        await new Promise(resolve => setTimeout(resolve, 1000));
      }
      
      // Generate a random seed if not provided
      const seed = imageSeed || Math.floor(Math.random() * 1000000);
      
      // Start image generation with Together.ai API
      const response = await apiRequest(
        "POST",
        "/api/image/generate",
        {
          prompt: imagePrompt,
          style: imageStyle,
          negativePrompt: negativePrompt,
          seed: seed,
          width: imageWidth,
          height: imageHeight,
          numImages: numImages
        }
      );
      
      if (response.ok) {
        const responseData = await response.json();
        const data = responseData.data || responseData; // Handle either format
        
        // Check if this is a fallback response
        const isFallback = !!data.isFallback;
        
        setImageResult({
          images: data.images || [],
          isFallback: isFallback,
          error: data.error
        });
        
        setGeneratedContent({ 
          type: "image", 
          prompt: imagePrompt,
          result: data,
          style: imageStyle,
          isFallback: isFallback,
          error: data.error
        });
        
        // Only add points and achievement if not a fallback
        if (!isFallback) {
          // Add points and possibly achievement
          addPoints(35);
          
          if (!achievements.includes("Image Creator")) {
            addAchievement("Image Creator");
          }
          
          toast({
            title: "Image Generated!",
            description: "Your image has been generated successfully.",
            variant: "default"
          });
        } else {
          // Show fallback toast
          toast({
            title: "Limited Generation",
            description: data.error || "Image couldn't be fully generated. Using fallback mode.",
            variant: "default"
          });
        }
      } else {
        throw new Error("Failed to generate image");
      }
    } catch (error: any) {
      console.error("Error generating image:", error);
      
      // Check if it's an API key error (You can add more specific error detection logic)
      if (error.message?.includes('API key') || 
          error.message?.toLowerCase().includes('authenticate') || 
          error.message?.toLowerCase().includes('unauthorized')) {
        
        setApiKeyError("Failed to generate image: API key missing or invalid for Together AI.");
        setApiKeyService('together');
        setApiKeyModalOpen(true);
        
        toast({
          title: "API Key Required",
          description: "Please provide your Together AI API key to generate images.",
          variant: "destructive",
        });
      } else {
        toast({
          title: "Generation Failed",
          description: "Failed to generate image. Please try again.",
          variant: "destructive",
        });
      }
    } finally {
      setIsGeneratingImage(false);
    }
  };
  
  // Toggle preview mode for website
  const handleTogglePreview = () => {
    if (generatedContent?.type === 'website') {
      setPreviewMode(!previewMode);
      
      // If enabling preview, set iframe content after a short delay
      if (!previewMode && iframeRef.current) {
        setTimeout(() => {
          if (iframeRef.current) {
            const { html, css } = generatedContent.result;
            const doc = iframeRef.current.contentDocument;
            if (doc) {
              doc.open();
              doc.write(`
                <!DOCTYPE html>
                <html>
                <head>
                  <style>${css}</style>
                </head>
                <body>${html}</body>
                </html>
              `);
              doc.close();
            }
          }
        }, 100);
      }
    }
  };
  
  // Copy to clipboard with animation
  const copyToClipboard = (text: string, label: string) => {
    navigator.clipboard.writeText(text);
    toast({
      title: `${label} Copied!`,
      description: `${label} copied to clipboard.`,
    });
  };
  
  // Download generated image
  const downloadImage = (base64String: string, fileName: string) => {
    const link = document.createElement('a');
    link.href = `data:image/jpeg;base64,${base64String}`;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    
    toast({
      title: "Image Downloaded",
      description: `${fileName} has been saved to your downloads.`,
    });
    
    // Add points for copying content
    addPoints(5);
  };
  
  // Handle tab change
  const handleTabChange = (value: string) => {
    setActiveTab(value);
    
    // First time using each tab gives achievement
    if (value === "text" && !achievements.includes("Text Explorer")) {
      addAchievement("Text Explorer");
    } else if (value === "website" && !achievements.includes("Website Explorer")) {
      addAchievement("Website Explorer");
    } else if (value === "replit" && !achievements.includes("Replit Explorer")) {
      addAchievement("Replit Explorer");
    } else if (value === "video" && !achievements.includes("Video Explorer")) {
      addAchievement("Video Explorer");
    } else if (value === "image" && !achievements.includes("Image Explorer")) {
      addAchievement("Image Explorer");
    }
  };
  
  // Render generated content
  const renderGeneratedContent = () => {
    if (!generatedContent) return null;
    
    switch (generatedContent.type) {
      case "text":
        return (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <Card className="mt-6 bg-secondary bg-opacity-5 overflow-hidden">
              <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                <div className="flex items-center justify-between">
                  <CardTitle className="flex items-center">
                    <Sparkles className="mr-2 h-5 w-5" />
                    Generated Text
                  </CardTitle>
                  <div className="flex gap-2">
                    <Badge variant="outline" className="bg-white text-primary">
                      {generatedContent.style} Style
                    </Badge>
                    {generatedContent.isFallback && (
                      <Badge variant="outline" className="bg-yellow-100 text-yellow-800">
                        Fallback
                      </Badge>
                    )}
                  </div>
                </div>
              </CardHeader>
              <CardContent className="p-5">
                <div className="mb-5 bg-gray-100 p-3 rounded-md">
                  <h3 className="text-sm font-semibold text-gray-700 mb-1">Original Text:</h3>
                  <div className="text-gray-600">{generatedContent.original}</div>
                </div>
                <div>
                  <h3 className="text-sm font-semibold text-gray-700 mb-1">Transformed Text:</h3>
                  <div className="whitespace-pre-wrap">{generatedContent.transformed}</div>
                </div>
              </CardContent>
              <CardFooter className="p-4 bg-secondary bg-opacity-10">
                <Button 
                  variant="outline" 
                  className="flex items-center transition-all hover:scale-105"
                  onClick={() => copyToClipboard(generatedContent.transformed, "Text")}
                >
                  <Copy className="mr-2 h-4 w-4" />
                  Copy to Clipboard
                </Button>
              </CardFooter>
            </Card>
          </motion.div>
        );
      case "website":
        return (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <Card className="mt-6 overflow-hidden">
              <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                <div className="flex items-center justify-between">
                  <CardTitle className="flex items-center">
                    <Code className="mr-2 h-5 w-5" />
                    Generated Website
                  </CardTitle>
                  <div className="flex gap-2">
                    <Badge variant="outline" className="bg-white text-primary">
                      {websiteTheme}
                    </Badge>
                    {generatedContent.isFallback && (
                      <Badge variant="outline" className="bg-yellow-100 text-yellow-800">
                        Fallback
                      </Badge>
                    )}
                    <Button 
                      size="sm" 
                      variant={previewMode ? "default" : "outline"} 
                      className="h-8 bg-white text-primary hover:bg-gray-100"
                      onClick={handleTogglePreview}
                    >
                      {previewMode ? "View Code" : "Preview"}
                    </Button>
                  </div>
                </div>
              </CardHeader>
              
              {previewMode ? (
                <div className="h-[500px] border-b border-gray-200">
                  <iframe 
                    ref={iframeRef} 
                    className="w-full h-full"
                    title="Website Preview"
                  />
                </div>
              ) : (
                <CardContent className="p-0">
                  <motion.div 
                    className="p-4"
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    transition={{ delay: 0.1 }}
                  >
                    <h3 className="font-bold mb-2 flex items-center">
                      <Terminal className="mr-2 h-4 w-4" />
                      HTML Code
                    </h3>
                    <pre className="bg-gray-800 text-white p-4 rounded text-sm overflow-auto max-h-80">
                      {generatedContent.result.html}
                    </pre>
                  </motion.div>
                  <motion.div 
                    className="p-4 border-t"
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    transition={{ delay: 0.2 }}
                  >
                    <h3 className="font-bold mb-2 flex items-center">
                      <Wand2 className="mr-2 h-4 w-4" />
                      CSS Code
                    </h3>
                    <pre className="bg-gray-800 text-white p-4 rounded text-sm overflow-auto max-h-80">
                      {generatedContent.result.css}
                    </pre>
                  </motion.div>
                  <motion.div 
                    className="p-4 border-t"
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    transition={{ delay: 0.3 }}
                  >
                    <h3 className="font-bold mb-2 flex items-center">
                      <MessageSquarePlus className="mr-2 h-4 w-4" />
                      Site Map
                    </h3>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {generatedContent.result.siteMap?.map((page: any, index: number) => (
                        <motion.div
                          key={index}
                          initial={{ opacity: 0, y: 10 }}
                          animate={{ opacity: 1, y: 0 }}
                          transition={{ delay: 0.1 * index }}
                        >
                          <Card className="bg-gray-50 hover:shadow-md transition-all hover:-translate-y-1">
                            <CardContent className="p-4">
                              <h4 className="font-bold">{page.title}</h4>
                              <p className="text-gray-700 text-sm mt-1">{page.description}</p>
                            </CardContent>
                          </Card>
                        </motion.div>
                      ))}
                    </div>
                  </motion.div>
                </CardContent>
              )}
              
              <CardFooter className="p-4 bg-secondary bg-opacity-10">
                <div className="flex flex-wrap gap-2">
                  <Button 
                    variant="outline" 
                    className="flex items-center transition-all hover:scale-105"
                    onClick={() => copyToClipboard(generatedContent.result.html, "HTML")}
                  >
                    <Copy className="mr-2 h-4 w-4" />
                    Copy HTML
                  </Button>
                  <Button 
                    variant="outline" 
                    className="flex items-center transition-all hover:scale-105"
                    onClick={() => copyToClipboard(generatedContent.result.css, "CSS")}
                  >
                    <Copy className="mr-2 h-4 w-4" />
                    Copy CSS
                  </Button>
                  <Button 
                    variant="default"
                    className="flex items-center transition-all hover:scale-105"
                    onClick={() => {
                      const combinedCode = `<!-- HTML -->\n${generatedContent.result.html}\n\n/* CSS */\n${generatedContent.result.css}`;
                      copyToClipboard(combinedCode, "All Code");
                    }}
                  >
                    <Copy className="mr-2 h-4 w-4" />
                    Copy All Code
                  </Button>
                </div>
              </CardFooter>
            </Card>
          </motion.div>
        );
      case "replitApp":
        return (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <Card className="mt-6 overflow-hidden">
              <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                <div className="flex items-center justify-between">
                  <CardTitle className="flex items-center">
                    <Rocket className="mr-2 h-5 w-5" />
                    Generated Replit App
                  </CardTitle>
                  <div className="flex gap-2">
                    <Badge variant="outline" className="bg-white text-primary">
                      {replitAppLanguage}
                    </Badge>
                    <Badge variant="outline" className="bg-white text-primary">
                      {replitAppFrameworks}
                    </Badge>
                    {generatedContent.isFallback && (
                      <Badge variant="outline" className="bg-yellow-100 text-yellow-800">
                        Fallback
                      </Badge>
                    )}
                  </div>
                </div>
              </CardHeader>
              <CardContent className="p-0">
                <motion.div 
                  className="p-4"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.1 }}
                >
                  <h3 className="font-bold mb-2 flex items-center">
                    <Terminal className="mr-2 h-4 w-4" />
                    App Structure
                  </h3>
                  <pre className="bg-gray-800 text-white p-4 rounded text-sm overflow-auto max-h-80">
                    {generatedContent.result.additionalFiles ? 
                      Array.isArray(generatedContent.result.additionalFiles) ?
                        generatedContent.result.additionalFiles.map((file: { filename: string }) => 
                          `${file.filename}\n`
                        ).join("") 
                        : "No file structure data available"
                      : "No file structure data available"}
                  </pre>
                </motion.div>
                <motion.div 
                  className="p-4 border-t"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.2 }}
                >
                  <h3 className="font-bold mb-2 flex items-center">
                    <Code className="mr-2 h-4 w-4" />
                    Main File
                  </h3>
                  <pre className="bg-gray-800 text-white p-4 rounded text-sm overflow-auto max-h-80">
                    {generatedContent.result.mainCode || "No main file code available"}
                  </pre>
                </motion.div>
                <motion.div 
                  className="p-4 border-t"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.3 }}
                >
                  <h3 className="font-bold mb-2 flex items-center">
                    <CheckCircle2 className="mr-2 h-4 w-4" />
                    Installation Instructions
                  </h3>
                  <ol className="list-decimal ml-5 space-y-2">
                    {generatedContent.result.setupInstructions ? (
                      typeof generatedContent.result.setupInstructions === 'string' ? (
                        <motion.li 
                          initial={{ opacity: 0, x: -5 }}
                          animate={{ opacity: 1, x: 0 }}
                        >
                          {generatedContent.result.setupInstructions}
                        </motion.li>
                      ) : (
                        Array.isArray(generatedContent.result.setupInstructions) && 
                        generatedContent.result.setupInstructions.map((instruction: string, index: number) => (
                          <motion.li 
                            key={index}
                            initial={{ opacity: 0, x: -5 }}
                            animate={{ opacity: 1, x: 0 }}
                            transition={{ delay: 0.1 * index }}
                          >
                            {instruction}
                          </motion.li>
                        ))
                      )
                    ) : (
                      <motion.li>No setup instructions available</motion.li>
                    )}
                  </ol>
                </motion.div>
              </CardContent>
              <CardFooter className="p-4 bg-secondary bg-opacity-10">
                <div className="flex flex-wrap gap-2">
                  <Button 
                    variant="outline" 
                    className="flex items-center transition-all hover:scale-105"
                    onClick={() => copyToClipboard(generatedContent.result.mainCode || "", "Main File")}
                  >
                    <Copy className="mr-2 h-4 w-4" />
                    Copy Main File
                  </Button>
                  <Button 
                    variant="default"
                    className="flex items-center transition-all hover:scale-105"
                    onClick={() => {
                      const allContent = JSON.stringify(generatedContent.result, null, 2);
                      copyToClipboard(allContent, "All Details");
                    }}
                  >
                    <Copy className="mr-2 h-4 w-4" />
                    Copy All Details
                  </Button>
                </div>
              </CardFooter>
            </Card>
          </motion.div>
        );
      case "video":
        return (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <Card className="mt-6 overflow-hidden">
              <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                <div className="flex items-center justify-between">
                  <CardTitle className="flex items-center">
                    <Film className="mr-2 h-5 w-5" />
                    Generated Video
                  </CardTitle>
                  <div className="flex gap-2">
                    <Badge variant="outline" className="bg-white text-primary">
                      {generatedContent.style}
                    </Badge>
                    <Badge variant="outline" className="bg-white text-primary">
                      {generatedContent.duration}
                    </Badge>
                    {generatedContent.isFallback && (
                      <Badge variant="outline" className="bg-yellow-100 text-yellow-800">
                        Fallback
                      </Badge>
                    )}
                  </div>
                </div>
              </CardHeader>
              <CardContent className="p-5">
                <div className="mb-5 bg-gray-100 p-3 rounded-md">
                  <h3 className="text-sm font-semibold text-gray-700 mb-1">Video Prompt:</h3>
                  <div className="text-gray-600">{generatedContent.prompt}</div>
                </div>
                
                {generatedContent.result.videoUrl ? (
                  <div className="aspect-video bg-black rounded-md overflow-hidden">
                    <video 
                      controls 
                      className="w-full h-full"
                      poster={generatedContent.result.thumbnailUrl || ''}
                    >
                      <source src={generatedContent.result.videoUrl} type="video/mp4" />
                      Your browser does not support the video tag.
                    </video>
                  </div>
                ) : (
                  <div className="bg-gray-800 text-white p-8 rounded-md text-center">
                    <div className="mx-auto mb-4 opacity-50 flex justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="lucide lucide-film">
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                        <line x1="7" x2="7" y1="3" y2="21"></line>
                        <line x1="17" x2="17" y1="3" y2="21"></line>
                        <line x1="3" x2="21" y1="7" y2="7"></line>
                        <line x1="3" x2="21" y1="17" y2="17"></line>
                      </svg>
                    </div>
                    <h3 className="text-xl font-medium mb-2">Video Being Processed</h3>
                    <p className="text-gray-400 mb-4">
                      Your video is currently being rendered. This process can take a few moments.
                    </p>
                    <div className="max-w-md mx-auto">
                      <Progress value={videoProgress} className="h-2 mb-2" />
                      <p className="text-sm text-gray-400">Status: {generatedContent.result.status || "Processing"}</p>
                    </div>
                  </div>
                )}
              </CardContent>
              <CardFooter className="p-4 bg-gray-100">
                <div className="flex flex-col sm:flex-row gap-4 w-full">
                  {generatedContent.result.videoUrl && (
                    <a 
                      href={generatedContent.result.videoUrl} 
                      target="_blank"
                      rel="noopener noreferrer"
                      className="inline-flex"
                    >
                      <Button className="bg-gradient-to-r from-primary to-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className="mr-2 h-4 w-4">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                          <polyline points="7 10 12 15 17 10"></polyline>
                          <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Download Video
                      </Button>
                    </a>
                  )}
                </div>
              </CardFooter>
            </Card>
          </motion.div>
        );
      case "image":
        return (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <Card className="mt-6 overflow-hidden">
              <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                <div className="flex items-center justify-between">
                  <CardTitle className="flex items-center">
                    <Film className="mr-2 h-5 w-5" />
                    Generated Images
                  </CardTitle>
                  <div className="flex gap-2">
                    <Badge variant="outline" className="bg-white text-primary">
                      {imageStyle}
                    </Badge>
                    {generatedContent.isFallback && (
                      <Badge variant="outline" className="bg-yellow-100 text-yellow-800">
                        Fallback
                      </Badge>
                    )}
                  </div>
                </div>
              </CardHeader>
              <CardContent className="p-5">
                {generatedContent.isFallback ? (
                  <div className="text-center py-8">
                    <div className="mb-4 bg-yellow-50 p-5 rounded-lg border border-yellow-200">
                      <AlertCircle className="h-10 w-10 text-yellow-500 mx-auto mb-2" />
                      <h3 className="text-lg font-semibold text-yellow-700">Image Generation Limited</h3>
                      <p className="text-gray-600 mt-2">{generatedContent.error || "Unable to generate images at this time."}</p>
                    </div>
                    
                    <div className="mt-6 bg-gray-100 p-3 rounded-md">
                      <h3 className="text-sm font-semibold text-gray-700 mb-1">Your Prompt:</h3>
                      <div className="text-gray-600">{generatedContent.prompt || "No prompt available"}</div>
                    </div>
                    
                    <Button 
                      variant="outline" 
                      className="mt-4"
                      onClick={() => setGeneratedContent(null)}
                    >
                      <RefreshCw className="mr-2 h-4 w-4" />
                      Try Again
                    </Button>
                  </div>
                ) : generatedContent.images && generatedContent.images.length > 0 ? (
                  <div>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                      {generatedContent.images.map((imgBase64: string, index: number) => (
                        <div key={index} className="relative group">
                          <img 
                            src={`data:image/jpeg;base64,${imgBase64}`}
                            alt={`Generated image ${index + 1}`}
                            className="w-full rounded-lg shadow-md transition-all"
                          />
                          <div className="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all">
                            <Button 
                              variant="secondary"
                              size="sm"
                              className="mx-1"
                              onClick={() => downloadImage(imgBase64, `generated-image-${index + 1}.jpg`)}
                            >
                              <Download className="h-4 w-4 mr-1" />
                              Download
                            </Button>
                          </div>
                        </div>
                      ))}
                    </div>
                    <div className="mt-4 bg-gray-100 p-3 rounded-md">
                      <h3 className="text-sm font-semibold text-gray-700 mb-1">Prompt:</h3>
                      <div className="text-gray-600">{generatedContent.prompt}</div>
                      {generatedContent.negativePrompt && (
                        <>
                          <h3 className="text-sm font-semibold text-gray-700 mt-2 mb-1">Negative Prompt:</h3>
                          <div className="text-gray-600">{generatedContent.negativePrompt}</div>
                        </>
                      )}
                    </div>
                  </div>
                ) : (
                  <div className="text-center py-8">
                    <Loader2 className="h-10 w-10 text-primary mx-auto animate-spin mb-4" />
                    <p>Your images are being generated...</p>
                    <p className="text-sm text-gray-600 mt-2">This might take a moment.</p>
                  </div>
                )}
              </CardContent>
            </Card>
          </motion.div>
        );
      default:
        return null;
    }
  };
  
  return (
    <section className="py-16 bg-gray-50 relative">
      <div className="container mx-auto px-4">
        <div className="text-center mb-12">
          <h2 className="text-3xl font-bold font-sans text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">
            AI-Powered Content Tools
          </h2>
          <p className="text-lg text-gray-600 mt-2">Create videos, transform text, and build websites with advanced AI</p>
        </div>
        
        <Tabs defaultValue="text" className="mb-8" onValueChange={handleTabChange}>
          <TabsList className="grid grid-cols-5 mb-8 w-full">
            <TabsTrigger value="text" className="data-[state=active]:bg-primary data-[state=active]:text-white transition-all">
              Text Transformer
            </TabsTrigger>
            <TabsTrigger value="website" className="data-[state=active]:bg-primary data-[state=active]:text-white transition-all">
              Website Builder
            </TabsTrigger>
            <TabsTrigger value="replit" className="data-[state=active]:bg-primary data-[state=active]:text-white transition-all">
              Replit App Creator
            </TabsTrigger>
            <TabsTrigger value="video" className="data-[state=active]:bg-primary data-[state=active]:text-white transition-all">
              Video Generator
            </TabsTrigger>
            <TabsTrigger value="image" className="data-[state=active]:bg-primary data-[state=active]:text-white transition-all">
              Image Generator
            </TabsTrigger>
          </TabsList>
          
          <TabsContent value="video">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.3 }}
            >
              <Card className="shadow-lg border-0 overflow-hidden">
                <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                  <div className="flex items-center">
                    <i className="ri-movie-line mr-2"></i>
                    <CardTitle className="font-medium">AI Video Generator</CardTitle>
                  </div>
                </CardHeader>
                <CardContent className="p-5">
                  <div className="mb-4">
                    <label className="block text-sm font-medium text-gray-600 mb-1">
                      Enter your prompt
                    </label>
                    <Textarea
                      rows={3}
                      placeholder="Describe the video you want to create..."
                      className="w-full transition-all focus:ring-2 focus:ring-primary"
                      value={videoPrompt}
                      onChange={(e) => setVideoPrompt(e.target.value)}
                    />
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Style
                      </label>
                      <Select value={videoStyle} onValueChange={setVideoStyle}>
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="3D Animation">3D Animation</SelectItem>
                          <SelectItem value="2D Animation">2D Animation</SelectItem>
                          <SelectItem value="Motion Graphics">Motion Graphics</SelectItem>
                          <SelectItem value="Cinematic">Cinematic</SelectItem>
                          <SelectItem value="Educational">Educational</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>

                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Duration
                      </label>
                      <Select value={videoDuration} onValueChange={setVideoDuration}>
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="15 seconds">15 seconds</SelectItem>
                          <SelectItem value="30 seconds">30 seconds</SelectItem>
                          <SelectItem value="60 seconds">60 seconds</SelectItem>
                          <SelectItem value="2 minutes">2 minutes</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                  </div>
                  
                  {isGeneratingVideo && (
                    <div className="mb-4">
                      <div className="flex justify-between text-sm text-gray-600 mb-1">
                        <span>Video generation in progress</span>
                        <span>{videoProgress}%</span>
                      </div>
                      <Progress value={videoProgress} className="h-2" />
                    </div>
                  )}

                  <Button 
                    className="w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 transition-all" 
                    onClick={handleVideoGeneration}
                    disabled={isGeneratingVideo}
                  >
                    {isGeneratingVideo ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        Generating...
                      </>
                    ) : (
                      "Generate Video"
                    )}
                  </Button>
                </CardContent>
              </Card>
            </motion.div>
          </TabsContent>
          
          <TabsContent value="text">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.3 }}
            >
              <Card className="shadow-lg border-0 overflow-hidden">
                <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                  <div className="flex items-center">
                    <i className="ri-file-text-line mr-2"></i>
                    <CardTitle className="font-medium">AI Text Transformer</CardTitle>
                  </div>
                </CardHeader>
                <CardContent className="p-5">
                  <div className="mb-4">
                    <label className="block text-sm font-medium text-gray-600 mb-1">
                      Enter your text
                    </label>
                    <Textarea
                      rows={5}
                      placeholder="Enter the text you want to transform..."
                      className="w-full transition-all focus:ring-2 focus:ring-primary"
                      value={textContent}
                      onChange={(e) => setTextContent(e.target.value)}
                    />
                  </div>

                  <div className="mb-4">
                    <div className="flex justify-between items-center">
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Transformation Style
                      </label>
                      <Badge variant="outline" className="bg-primary text-white">
                        {transformStyle}
                      </Badge>
                    </div>
                    <Select value={transformStyle} onValueChange={setTransformStyle}>
                      <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="Creative">Creative</SelectItem>
                        <SelectItem value="Professional">Professional</SelectItem>
                        <SelectItem value="Academic">Academic</SelectItem>
                        <SelectItem value="Simplified">Simplified</SelectItem>
                        <SelectItem value="Poetic">Poetic</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                  
                  {isTransformingText && (
                    <div className="mb-4">
                      <div className="flex justify-between text-sm text-gray-600 mb-1">
                        <span>Transformation in progress</span>
                        <span>{textProgress}%</span>
                      </div>
                      <Progress value={textProgress} className="h-2" />
                    </div>
                  )}

                  <Button 
                    className="w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 transition-all" 
                    onClick={handleTextTransform}
                    disabled={isTransformingText}
                  >
                    {isTransformingText ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        Transforming...
                      </>
                    ) : (
                      "Transform Text"
                    )}
                  </Button>
                </CardContent>
              </Card>
            </motion.div>
          </TabsContent>
          
          <TabsContent value="website">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.3 }}
            >
              <Card className="shadow-lg border-0 overflow-hidden">
                <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                  <div className="flex items-center">
                    <i className="ri-global-line mr-2"></i>
                    <CardTitle className="font-medium">AI Website Builder</CardTitle>
                  </div>
                </CardHeader>
                <CardContent className="p-5">
                  <div className="mb-4">
                    <label className="block text-sm font-medium text-gray-600 mb-1">
                      Website Description
                    </label>
                    <Textarea
                      rows={4}
                      placeholder="Describe the website you want to create..."
                      className="w-full transition-all focus:ring-2 focus:ring-primary"
                      value={websiteDescription}
                      onChange={(e) => setWebsiteDescription(e.target.value)}
                    />
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div>
                      <div className="flex justify-between items-center">
                        <label className="block text-sm font-medium text-gray-600 mb-1">
                          Theme
                        </label>
                        <Badge variant="outline" className="bg-primary text-white">
                          {websiteTheme}
                        </Badge>
                      </div>
                      <Select value={websiteTheme} onValueChange={setWebsiteTheme}>
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="Modern">Modern</SelectItem>
                          <SelectItem value="Minimalist">Minimalist</SelectItem>
                          <SelectItem value="Corporate">Corporate</SelectItem>
                          <SelectItem value="Creative">Creative</SelectItem>
                          <SelectItem value="E-commerce">E-commerce</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>

                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Pages
                      </label>
                      <Select value={websitePages} onValueChange={setWebsitePages}>
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="Landing Page">Landing Page</SelectItem>
                          <SelectItem value="Multi-page (3-5)">Multi-page (3-5)</SelectItem>
                          <SelectItem value="Portfolio">Portfolio</SelectItem>
                          <SelectItem value="Blog">Blog</SelectItem>
                          <SelectItem value="E-commerce">E-commerce</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                    
                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Branding Name (Optional)
                      </label>
                      <Input 
                        placeholder="Enter your brand name"
                        value={brandingName}
                        onChange={(e) => setBrandingName(e.target.value)}
                        className="transition-all focus:ring-2 focus:ring-primary"
                      />
                    </div>
                  </div>
                  
                  {isGeneratingWebsite && (
                    <div className="mb-4">
                      <div className="flex justify-between text-sm text-gray-600 mb-1">
                        <span>Website generation in progress</span>
                        <span>{websiteProgress}%</span>
                      </div>
                      <Progress value={websiteProgress} className="h-2" />
                    </div>
                  )}

                  <Button 
                    className="w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 transition-all" 
                    onClick={handleWebsiteGeneration}
                    disabled={isGeneratingWebsite}
                  >
                    {isGeneratingWebsite ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        Generating Website...
                      </>
                    ) : (
                      "Generate Website"
                    )}
                  </Button>
                </CardContent>
              </Card>
            </motion.div>
          </TabsContent>
          
          <TabsContent value="replit">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.3 }}
            >
              <Card className="shadow-lg border-0 overflow-hidden">
                <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                  <div className="flex items-center">
                    <i className="ri-code-box-line mr-2"></i>
                    <CardTitle className="font-medium">Replit App Generator</CardTitle>
                  </div>
                </CardHeader>
                <CardContent className="p-5">
                  <div className="mb-4">
                    <label className="block text-sm font-medium text-gray-600 mb-1">
                      App Description
                    </label>
                    <Textarea
                      rows={4}
                      placeholder="Describe the Replit app you want to create..."
                      className="w-full transition-all focus:ring-2 focus:ring-primary"
                      value={replitAppDescription}
                      onChange={(e) => setReplitAppDescription(e.target.value)}
                    />
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <div className="flex justify-between items-center">
                        <label className="block text-sm font-medium text-gray-600 mb-1">
                          Programming Language
                        </label>
                        <Badge variant="outline" className="bg-primary text-white">
                          {replitAppLanguage}
                        </Badge>
                      </div>
                      <Select value={replitAppLanguage} onValueChange={setReplitAppLanguage}>
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="JavaScript">JavaScript</SelectItem>
                          <SelectItem value="Python">Python</SelectItem>
                          <SelectItem value="HTML/CSS/JS">HTML/CSS/JS</SelectItem>
                          <SelectItem value="TypeScript">TypeScript</SelectItem>
                          <SelectItem value="Node.js">Node.js</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>

                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Framework/Library
                      </label>
                      <Select value={replitAppFrameworks} onValueChange={setReplitAppFrameworks}>
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="React">React</SelectItem>
                          <SelectItem value="Express">Express</SelectItem>
                          <SelectItem value="Flask">Flask</SelectItem>
                          <SelectItem value="Next.js">Next.js</SelectItem>
                          <SelectItem value="Vanilla">Vanilla (No Framework)</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                  </div>
                  
                  {isGeneratingReplitApp && (
                    <div className="mb-4">
                      <div className="flex justify-between text-sm text-gray-600 mb-1">
                        <span>App generation in progress</span>
                        <span>{replitProgress}%</span>
                      </div>
                      <Progress value={replitProgress} className="h-2" />
                    </div>
                  )}

                  <Button 
                    className="w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 transition-all" 
                    onClick={handleReplitAppGeneration}
                    disabled={isGeneratingReplitApp}
                  >
                    {isGeneratingReplitApp ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        Generating Replit App...
                      </>
                    ) : (
                      "Generate Replit App"
                    )}
                  </Button>
                </CardContent>
              </Card>
            </motion.div>
          </TabsContent>
          
          <TabsContent value="image">
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.3 }}
            >
              <Card className="shadow-lg border-0 overflow-hidden">
                <CardHeader className="bg-gradient-to-r from-secondary to-primary text-white p-4">
                  <div className="flex items-center">
                    <i className="ri-image-line mr-2"></i>
                    <CardTitle className="font-medium">AI Image Generator</CardTitle>
                  </div>
                </CardHeader>
                <CardContent className="p-5">
                  <div className="mb-4">
                    <label className="block text-sm font-medium text-gray-600 mb-1">
                      Enter your prompt
                    </label>
                    <Textarea
                      rows={3}
                      placeholder="Describe the image you want to create..."
                      className="w-full transition-all focus:ring-2 focus:ring-primary"
                      value={imagePrompt}
                      onChange={(e) => setImagePrompt(e.target.value)}
                    />
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Style
                      </label>
                      <Select value={imageStyle} onValueChange={setImageStyle}>
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="Photorealistic">Photorealistic</SelectItem>
                          <SelectItem value="Digital Art">Digital Art</SelectItem>
                          <SelectItem value="3D Rendering">3D Rendering</SelectItem>
                          <SelectItem value="Fantasy">Fantasy</SelectItem>
                          <SelectItem value="Anime">Anime</SelectItem>
                          <SelectItem value="Oil Painting">Oil Painting</SelectItem>
                          <SelectItem value="Watercolor">Watercolor</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>

                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Number of Images
                      </label>
                      <Select 
                        value={numImages.toString()} 
                        onValueChange={(value) => setNumImages(parseInt(value))}
                      >
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="1">1 Image</SelectItem>
                          <SelectItem value="2">2 Images</SelectItem>
                          <SelectItem value="3">3 Images</SelectItem>
                          <SelectItem value="4">4 Images</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                  </div>
                  
                  <div className="mb-4">
                    <label className="block text-sm font-medium text-gray-600 mb-1">
                      Negative Prompt (what to avoid in the image)
                    </label>
                    <Input
                      placeholder="e.g., blurry, bad quality, distorted, low resolution"
                      className="w-full transition-all focus:ring-2 focus:ring-primary"
                      value={negativePrompt}
                      onChange={(e) => setNegativePrompt(e.target.value)}
                    />
                  </div>
                  
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Width
                      </label>
                      <Select 
                        value={imageWidth.toString()} 
                        onValueChange={(value) => setImageWidth(parseInt(value))}
                      >
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="512">512px</SelectItem>
                          <SelectItem value="768">768px</SelectItem>
                          <SelectItem value="1024">1024px</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>

                    <div>
                      <label className="block text-sm font-medium text-gray-600 mb-1">
                        Height
                      </label>
                      <Select 
                        value={imageHeight.toString()} 
                        onValueChange={(value) => setImageHeight(parseInt(value))}
                      >
                        <SelectTrigger className="transition-all focus:ring-2 focus:ring-primary">
                          <SelectValue />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="512">512px</SelectItem>
                          <SelectItem value="768">768px</SelectItem>
                          <SelectItem value="1024">1024px</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                  </div>
                  
                  {isGeneratingImage && (
                    <div className="mb-4">
                      <div className="flex justify-between text-sm text-gray-600 mb-1">
                        <span>Image generation in progress</span>
                        <span>{imageProgress}%</span>
                      </div>
                      <Progress value={imageProgress} className="h-2" />
                    </div>
                  )}

                  <Button 
                    className="w-full bg-gradient-to-r from-primary to-secondary hover:opacity-90 transition-all" 
                    onClick={handleImageGeneration}
                    disabled={isGeneratingImage}
                  >
                    {isGeneratingImage ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        Generating...
                      </>
                    ) : (
                      "Generate Image"
                    )}
                  </Button>
                </CardContent>
              </Card>
            </motion.div>
          </TabsContent>
        </Tabs>
        
        {renderGeneratedContent()}
        
        {/* Points and Achievements System */}
        <PointsSystem 
          points={points} 
          level={level} 
          onAchievement={addAchievement} 
        />
        
        {/* Achievement notification */}
        <AnimatePresence>
          {showAchievement && (
            <motion.div
              className="fixed top-20 right-4 bg-gradient-to-r from-primary to-secondary text-white py-2 px-4 rounded-lg shadow-lg z-50 flex items-center"
              initial={{ opacity: 0, y: -50, scale: 0.8 }}
              animate={{ opacity: 1, y: 0, scale: 1 }}
              exit={{ opacity: 0, y: -50, scale: 0.8 }}
              transition={{ duration: 0.4 }}
            >
              <Award className="mr-2 h-5 w-5" />
              <div>
                <div className="font-bold">Achievement Unlocked!</div>
                <div className="text-sm">{showAchievement}</div>
              </div>
              <div className="ml-3 font-bold text-yellow-200">+50 pts</div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </section>
    
    {/* API Key Modal */}
    <ApiKeyModal
      isOpen={apiKeyModalOpen}
      onClose={() => setApiKeyModalOpen(false)}
      onSuccess={() => {
        setApiKeyModalOpen(false);
        toast({
          title: "API Key Saved",
          description: "Your API key has been saved successfully.",
          variant: "default",
        });
      }}
      defaultService={apiKeyService}
      error={apiKeyError}
    />
  );
};

export default AITools;